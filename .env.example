# Google API key for the Gemini model.
# Get a key from https://aistudio.google.com/app/apikeys.
GOOGLE_API_KEY=your_api_key_here

# Alternative key name. The engine checks GEMINI_API_KEY first, then GOOGLE_API_KEY.
GEMINI_API_KEY=

# Optional settings.
MODEL_NAME=gemini-2.5-flash
SPREADSHEET_NAME=club-membership-system-members
